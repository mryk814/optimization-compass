{
  "name": "optimization-compass-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest --exclude=e2e/**",
    "parity": "vitest run --config vite.parity.config.ts",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "npm run build && npm run test:e2e:artifact",
    "test:e2e:artifact": "playwright test",
    "test:e2e:critical": "playwright test --grep @critical --project=chromium-desktop",
    "test:e2e:report": "playwright show-report",
    "record:scene": "node scripts/record-scene.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
